      "name": "release-shared",
      "configurePreset": "release-shared",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "profiling",
      "configurePreset": "profiling",
