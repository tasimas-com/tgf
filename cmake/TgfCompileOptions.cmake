# Shared compile policy. Every TGF target calls tgf_apply_policy(<target> [CORE]).
#   CORE: the library implementation itself — no exceptions, no RTTI (ADR-0001).
#         Public headers stay usable from code compiled WITH exceptions/RTTI.

include(CheckIPOSupported)
set(TGF_LTO_AVAILABLE OFF)
if(TGF_ENABLE_LTO)
  check_ipo_supported(RESULT _ipo_ok OUTPUT _ipo_msg LANGUAGES CXX)
  if(_ipo_ok)
    set(TGF_LTO_AVAILABLE ON)
  else()
    message(STATUS "TGF: LTO not available (${_ipo_msg})")
  endif()
endif()

# MSVC: CMake's default CMAKE_CXX_FLAGS contain /EHsc and /GR. Our core library needs /EHs-c-
# and /GR-, and passing both produces warning D9025 ("overriding ..."). Remove the defaults here
# and let tgf_apply_policy() give every target exactly the exception/RTTI mode it wants.
if(MSVC)
  string(REGEX REPLACE "/EH[a-z-]+" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
  string(REGEX REPLACE "/GR-?( |$)" "\\1" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
  string(STRIP "${CMAKE_CXX_FLAGS}" CMAKE_CXX_FLAGS)
endif()

function(tgf_apply_policy target)
  cmake_parse_arguments(P "CORE" "" "" ${ARGN})

  # Sanitizer flags are applied to every compiled target (library, showcase, and
  # header-check objects) so instrumented code is linked with the matching runtime.
  if(NOT TGF_SANITIZER STREQUAL "None")
    if(MSVC)
      if(TGF_SANITIZER STREQUAL "Address")
        target_compile_options(${target} PRIVATE /fsanitize=address)
        target_link_options(${target} PRIVATE /INCREMENTAL:NO)
      else()
        message(FATAL_ERROR "MSVC supports only TGF_SANITIZER=Address in this project. Use Clang/GCC for UBSan, TSan, or MSan.")
      endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
      if(TGF_SANITIZER STREQUAL "Address")
        set(_tgf_sanitize "address")
      elseif(TGF_SANITIZER STREQUAL "Undefined")
        set(_tgf_sanitize "undefined")
      elseif(TGF_SANITIZER STREQUAL "Thread")
        set(_tgf_sanitize "thread")
      elseif(TGF_SANITIZER STREQUAL "Memory")
        if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
          message(FATAL_ERROR "MemorySanitizer requires Clang on Linux and an instrumented runtime/dependency set.")
        endif()
        set(_tgf_sanitize "memory")
        target_compile_options(${target} PRIVATE -fsanitize-memory-track-origins=2 -fPIE)
        target_link_options(${target} PRIVATE -pie)
      elseif(TGF_SANITIZER STREQUAL "AddressUndefined")
        set(_tgf_sanitize "address,undefined")
      else()
        message(FATAL_ERROR "Unknown sanitizer selection: ${TGF_SANITIZER}")
      endif()
      target_compile_options(${target} PRIVATE "-fsanitize=${_tgf_sanitize}" -fno-omit-frame-pointer)
      target_link_options(${target} PRIVATE "-fsanitize=${_tgf_sanitize}")
    else()
      message(FATAL_ERROR "TGF_SANITIZER='${TGF_SANITIZER}' is not supported by ${CMAKE_CXX_COMPILER_ID}.")
    endif()
  endif()

  if(MSVC)
    # C4324 (padding due to alignas) is intentional in cache-line-separated lock-free types.
    target_compile_options(${target} PRIVATE /W4 /wd4324 /permissive- /utf-8 /Zc:__cplusplus /fp:precise
      $<$<NOT:$<CONFIG:Debug>>:/O2 /Gy /Gw /GL>)
    target_link_options(${target} PRIVATE $<$<NOT:$<CONFIG:Debug>>:/LTCG /OPT:REF /OPT:ICF>)
    if(TGF_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE /WX)
    endif()
    if(P_CORE)
      target_compile_options(${target} PRIVATE /EHs-c- /GR-)
      target_compile_definitions(${target} PRIVATE _HAS_EXCEPTIONS=0)
    else()
      target_compile_options(${target} PRIVATE /EHsc /GR)
    endif()
  else()
    # -ffp-contract=off + no fast-math: bit-identical float results across compilers (ADR-0029).
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion
      -Wnon-virtual-dtor -Wold-style-cast -Wcast-align -Wformat=2 -ffp-contract=off)
    target_compile_options(${target} PRIVATE $<$<NOT:$<CONFIG:Debug>>:-O2 -fno-semantic-interposition -fdata-sections -ffunction-sections>)
    if(NOT APPLE)
      target_link_options(${target} PRIVATE $<$<NOT:$<CONFIG:Debug>>:-Wl,--gc-sections>)
    endif()
    if(TGF_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
    if(TGF_NATIVE_ARCH)
      target_compile_options(${target} PRIVATE -march=native)
    endif()
    if(P_CORE)
      target_compile_options(${target} PRIVATE -fno-exceptions -fno-rtti)
    endif()
  endif()

  if(TGF_LTO_AVAILABLE)
    set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
    set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO ON)
  endif()
endfunction()
