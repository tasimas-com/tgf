include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

install(TARGETS tgf_core EXPORT TGFTargets
  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(DIRECTORY core/include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
install(EXPORT TGFTargets NAMESPACE TGF:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/TGF)

configure_package_config_file(${CMAKE_CURRENT_LIST_DIR}/TGFConfig.cmake.in
  ${CMAKE_CURRENT_BINARY_DIR}/TGFConfig.cmake INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/TGF)
write_basic_package_version_file(${CMAKE_CURRENT_BINARY_DIR}/TGFConfigVersion.cmake
  VERSION ${PROJECT_VERSION} COMPATIBILITY SameMajorVersion)
install(FILES ${CMAKE_CURRENT_BINARY_DIR}/TGFConfig.cmake ${CMAKE_CURRENT_BINARY_DIR}/TGFConfigVersion.cmake
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/TGF)
